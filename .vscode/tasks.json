{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Watch Extension",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Watching for file changes.*$",
          "endsPattern": "^.*Found 0 errors.*$"
        }
      }
    }
  ]
}